# =============================================================================
# Monorepo root
# =============================================================================

.DS_Store
*.pem

# =============================================================================
# Web (Next.js) — web/
# =============================================================================

# dependencies
web/node_modules/
web/.pnp
web/.pnp.*
web/.yarn/*
!web/.yarn/patches
!web/.yarn/plugins
!web/.yarn/releases
!web/.yarn/versions

# testing
web/coverage/

# next.js
web/.next/
web/out/

# production
web/build/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
web/.env*
!web/.env.example

# vercel
web/.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts

# audio files (hosted on Cloudflare R2)
web/public/audio/**/*.m4a
web/public/audio/**/*.mp3
web/public/audio/**/*.flac
web/public/audio/**/*.wav

# wrangler (Cloudflare CLI)
web/.wrangler/

# =============================================================================
# iOS — ios/
# =============================================================================

# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
build/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xccheckout
*.moved-aside

# SPM
ios/.build/
ios/.swiftpm/

# Secrets (real values, not the .example)
ios/Ragaflow/Configuration/Secrets.xcconfig
ios/Ragaflow/Configuration/Debug.xcconfig
ios/Ragaflow/Configuration/Release.xcconfig

# CocoaPods (if ever used)
ios/Pods/

# track upload staging folder
uploads/

# integration test screenshots
tests/integration/screenshots/
