// Copy this to Debug.xcconfig and Release.xcconfig (both gitignored)
// These are read at build time via Info.plist and accessed via Bundle.main
// IMPORTANT: xcconfig treats // as a comment — use $() to break URLs

SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_your_key_here
